#!/usr/bin/env bash
# dev-server — supervised, isolated, memory-bounded dev server (Crate Engine).
# One supervised service per repo, auto-restart, restart-BY-NAME so one team can
# never broad-`pkill` another team's dev server.
#
# Three backends, picked by what the host actually offers —
#   Linux : systemd --user (Restart=always, MemoryMax cap, journald logs)
#   macOS : launchd gui domain (KeepAlive, logs to .agents/state/dev-server.log;
#           heap is bounded via NODE_OPTIONS — launchd has no MemoryMax equivalent,
#           documented limit)
#   bare  : nohup + pidfile, when there is NO supervisor at all — a seat sandbox,
#           or Linux with no user bus (CE-107). Unsupervised: no auto-restart, and
#           the only bound is the node heap. It exists because "no supervisor" used
#           to mean "no dev server", inside the wall where the coder lives.
#           Force it anywhere with DEV_BACKEND=bare.
# and the serve command is CONF-DRIVEN (de-Next-ified): rig.conf/dev.conf DEV_CMD
# wins; else the classic Next binary if the project has one; else `npm run dev`.
#
# Usage: dev-server <up|down|restart|status|logs|install> [PROJECT_PATH]
#   Config layered: <repo>/.agents/rig.conf, then <repo>/.agents/dev.conf, then env, then defaults:
#     DEV_CMD (serve command; may reference $DEV_PORT/$DEV_BIND — SINGLE-quote the value
#              in the conf so they expand at run time, not at source time) ·
#     DEV_PORT (else parsed from DEV_URL, else 3000) · DEV_BIND (0.0.0.0) ·
#     DEV_HEAP_MB (4096, node --max-old-space-size) · DEV_MEMMAX (6G, systemd-only cap)
set -uo pipefail

CMD="${1:?usage: dev-server <up|down|restart|status|logs|install> [PROJECT_PATH]}"
PROJ="${2:-${PROJECT_PATH:-$(pwd)}}"
[ -d "$PROJ" ] || { echo "dev-server: no such dir: $PROJ" >&2; exit 1; }
PROJ="$(cd "$PROJ" && pwd)"

# An explicit env DEV_PORT is the operator's word — captured BEFORE the conf
# files are sourced, because `.` would otherwise overwrite it (so the documented
# "env" layer never actually worked).
ENV_DEV_PORT="${DEV_PORT:-}"

# layer config (later sources override earlier)
[ -f "$PROJ/.agents/rig.conf" ] && . "$PROJ/.agents/rig.conf"
[ -f "$PROJ/.agents/dev.conf" ] && . "$PROJ/.agents/dev.conf"

# CE-106: the dev port comes from serve-resolve — the ONE source of truth, shared
# with preview-tunnel and the gate. This script used to work it out itself, and
# because it SOURCES dev.conf on top of rig.conf, a stale dev.conf DEV_PORT
# quietly beat the rig's own sheet. serve-resolve gives rig.conf priority.
SR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PORT="$ENV_DEV_PORT"
[ -z "$PORT" ] && PORT="$(bash "$SR_DIR/serve-resolve" dev "$PROJ" 2>/dev/null | sed -n 's/^PORT=//p')"
PORT="${PORT:-3000}"
DEV_PORT="$PORT"   # the serve command may reference $DEV_PORT; keep them identical
BIND="${DEV_BIND:-0.0.0.0}"
HEAP="${DEV_HEAP_MB:-4096}"
MEMMAX="${DEV_MEMMAX:-6G}"
NAME="cratedev-$(basename "$PROJ")"

# ── the serve command (conf-driven; Next is a default, not an assumption) ────
# ── the serve command — detection DELEGATED to serve-resolve: ONE source of
#    truth for "how does this project serve"; the gate's smoke rung consumes
#    the same resolution in prod-first mode (PDR dev/pdr/runtime-smoke-rung.md).
#    Deferred $DEV_PORT/$DEV_BIND tokens pre-expand here with the SAME values
#    the service environment carries — outcome identical, now deterministic.
serve_cmd() {
  local res cmd
  res="$(bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/serve-resolve" dev "$PROJ")" || return 1
  cmd="$(printf '%s\n' "$res" | sed -n 's/^CMD=//p')"
  if [ -z "$cmd" ]; then
    echo "dev-server: no DEV_CMD in rig.conf/dev.conf, no next binary, no package.json dev script — set DEV_CMD" >&2
    return 1
  fi
  cmd="${cmd//\$DEV_PORT/$PORT}"
  cmd="${cmd//\$DEV_BIND/$BIND}"
  printf '%s' "$cmd"
}

# Which backend supervises on this host?
# CE-107: there is ALWAYS a backend. A seat sandbox has neither systemd --user
# nor launchd, and returning 1 there made the whole tool unusable exactly where
# the coder needs it — so the last rung is `bare`: unsupervised, but running.
# CE-144 (probe rig, 2026-08-18; reproduced inside a rendered coder wall on the
# Mac): the launchd rung used to be chosen on a READ probe — `launchctl print`
# SUCCEEDS inside a seat's wall — while the thing the backend must actually DO is
# WRITE ~/Library/LaunchAgents/<name>.plist, which the wall denies ("Operation
# not permitted", and `launchctl bootstrap` then fails 5: I/O error). Probing the
# wrong capability made macOS seats fall off a cliff Linux seats never hit:
# superman's seats get systemd supervision, Mac seats got a hard error, and every
# `dev-server restart` runbook dead-ended inside the wall. So the probe now tests
# what the backend needs — can we write the plist?
ld_writable() {
  local d="$HOME/Library/LaunchAgents" probe
  mkdir -p "$d" 2>/dev/null || return 1
  probe="$d/.crate-writetest.$$"
  # A real write, not a permission-bit check: a sandbox denial does not show up
  # in the mode bits, which is exactly how this hid.
  ( : > "$probe" ) 2>/dev/null || return 1
  rm -f "$probe" 2>/dev/null || true
  return 0
}

backend() {
  if [ "${DEV_BACKEND:-}" = "bare" ]; then
    echo bare
  elif command -v systemctl >/dev/null 2>&1; then
    if systemctl --user show-environment >/dev/null 2>&1; then
      echo systemd
    else
      # CE-156 (engine-qa, first Linux run): systemd is INSTALLED but its user
      # bus is unreachable — a walled seat, or a session with no user bus
      # (CE-107). That is a demotion, and CE-144's lesson was that a silent one
      # leaves every "the supervisor brings it back" runbook quietly wrong. Same
      # words, same stderr, same acting-commands-only gate as the launchd branch
      # below; this branch simply never got them. When there is NO supervisor on
      # the host at all we stay quiet (the final else): nothing was lost.
      case "$CMD" in
        up|install|restart)
          echo "dev-server: systemd is present but its user bus is not reachable from here (a walled seat, or a session with no user bus) — using the BARE backend instead: the server runs and \`dev-server restart\` works, but there is NO auto-restart and no supervisor memory cap. Run it outside the wall for a supervised server." >&2
          ;;
      esac
      echo bare
    fi
  elif [ "$(uname -s)" = "Darwin" ] && launchctl print "gui/$(id -u)" >/dev/null 2>&1; then
    if ld_writable; then
      echo launchd
    else
      # Say it, don't just do it — the asymmetry with Linux is the thing that
      # confuses people, so name it once, on the commands that act. stderr, so
      # the note never lands in $(backend).
      case "$CMD" in
        up|install|restart)
          echo "dev-server: launchd is present but $HOME/Library/LaunchAgents is not writable from here (a walled seat) — using the BARE backend instead: the server runs and \`dev-server restart\` works, but there is NO auto-restart and no supervisor memory cap. Run it outside the wall for a supervised server." >&2
          ;;
      esac
      echo bare
    fi
  else
    echo bare
  fi
}

# Kill only THIS repo's ad-hoc (non-supervised) dev process — by exact binary path, or
# by "it LISTENS on our port AND its command names our project path" (covers non-Next
# servers, e.g. vite, since P4-7 de-Next-ified). Never a broad `pkill -f "next dev"`
# (that would kill every team's server).
kill_adhoc() {
  pkill -f "$PROJ/node_modules/.bin/next dev" 2>/dev/null || true
  pkill -f "$PROJ/node_modules/next/dist/bin/next" 2>/dev/null || true
  if command -v lsof >/dev/null 2>&1; then
    for pid in $(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null); do
      if ps -o command= -p "$pid" 2>/dev/null | grep -qF "$PROJ" \
         || lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | grep -qF "n$PROJ"; then
        kill "$pid" 2>/dev/null || true
      fi
    done
  fi
}

# ── shared state (CE-128) ────────────────────────────────────────────────────
# The server's lifetime spans invocations, but DEV_BACKEND is per-invocation:
# a bare `up` followed by a plain `down` on a systemd host stopped a unit that
# does not exist, printed DOWN, and left the server serving. So the backend
# that did the `up` is RECORDED next to the pidfile, later commands honor the
# record, and DOWN is a claim about the PORT — verified, never assumed.
st_dir() {
  if [ -d "$PROJ/.agents/state" ] && [ -w "$PROJ/.agents/state" ]; then echo "$PROJ/.agents/state"
  else echo "${TMPDIR:-/tmp}"; fi
}
backend_marker() { echo "$(st_dir)/$NAME.backend"; }
# Who is LISTENING on our port for this project? Pidfiles and unit names can
# go stale — the socket is the ground truth.
port_holder() {
  command -v lsof >/dev/null 2>&1 || return 0
  local pid
  for pid in $(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null); do
    if ps -o command= -p "$pid" 2>/dev/null | grep -qF "$PROJ" \
       || lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | grep -qF "n$PROJ"; then
      echo "$pid"; return 0
    fi
  done
}
# Runs after EVERY down, whichever backend handled it: sweep ad-hoc strays,
# then refuse to say DOWN while something of ours still listens.
down_seal() {
  kill_adhoc
  rm -f "$(backend_marker)"
  local i p=""
  for i in 1 2 3 4 5; do p="$(port_holder)"; [ -z "$p" ] && break; sleep 1; done
  if [ -n "$p" ]; then
    echo "dev-server: down FAILED — pid $p still LISTENS on $PORT for $(basename "$PROJ") (backend: $B). Inspect: ps -p $p" >&2
    exit 1
  fi
  echo "DOWN $NAME"
}

# ── systemd backend (Linux — unchanged behavior) ─────────────────────────────
sd_unit() { echo "$HOME/.config/systemd/user/$NAME.service"; }
sd_write() {
  local cmdline; cmdline="$(serve_cmd)" || exit 1
  mkdir -p "$(dirname "$(sd_unit)")"
  # Optional DB isolation: PREVIEW_DB_URL (a non-prod branch) injected as POSTGRES_URL.
  local preview_env=""
  [ -n "${PREVIEW_DB_URL:-}" ] && preview_env="Environment=POSTGRES_URL=$PREVIEW_DB_URL"
  cat > "$(sd_unit)" <<UNIT
[Unit]
Description=Crate Engine dev server — $(basename "$PROJ") (port $PORT)
After=network.target

[Service]
Type=simple
WorkingDirectory=$PROJ
Environment=NODE_OPTIONS=--max-old-space-size=$HEAP
Environment=DEV_PORT=$PORT
Environment=DEV_BIND=$BIND
$preview_env
ExecStart=/bin/bash -lc 'exec $cmdline'
Restart=always
RestartSec=3
MemoryMax=$MEMMAX

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
}
sd_run() {
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"   # `systemctl --user` over SSH
  case "$CMD" in
    install) sd_write; systemctl --user enable "$NAME" >/dev/null 2>&1 || true; echo "installed $NAME (port $PORT · heap ${HEAP}MB · MemoryMax $MEMMAX)";;
    up)      sd_write; systemctl --user stop "$NAME" 2>/dev/null || true; kill_adhoc; sleep 1; systemctl --user enable --now "$NAME"; echo "UP  $NAME -> $BIND:$PORT (heap ${HEAP}MB · MemoryMax $MEMMAX)";;
    down)    systemctl --user disable --now "$NAME" 2>/dev/null || true;;  # down_seal verifies + prints (CE-128)
    restart) systemctl --user restart "$NAME"; echo "restarted $NAME";;
    status)  systemctl --user --no-pager status "$NAME" 2>&1 | head -14 || true;;
    logs)    journalctl --user -u "$NAME" --no-pager -n "${LINES:-40}" 2>&1 || true;;
    *) echo "usage: dev-server <up|down|restart|status|logs|install> [PROJECT_PATH]" >&2; exit 1;;
  esac
}

# ── launchd backend (macOS — P4-7) ───────────────────────────────────────────
LD_UID="$(id -u)"
ld_plist() { echo "$HOME/Library/LaunchAgents/$NAME.plist"; }
ld_log() {
  if [ -d "$PROJ/.agents/state" ]; then echo "$PROJ/.agents/state/dev-server.log"; else echo "${TMPDIR:-/tmp}/$NAME.log"; fi
}
ld_write() {
  local cmdline log; cmdline="$(serve_cmd)" || exit 1; log="$(ld_log)"
  mkdir -p "$(dirname "$(ld_plist)")"
  local preview_env=""
  [ -n "${PREVIEW_DB_URL:-}" ] && preview_env="<key>POSTGRES_URL</key><string>$PREVIEW_DB_URL</string>"
  cat > "$(ld_plist)" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$NAME</string>
  <key>WorkingDirectory</key><string>$PROJ</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string><string>exec $cmdline</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>NODE_OPTIONS</key><string>--max-old-space-size=$HEAP</string>
    <key>DEV_PORT</key><string>$PORT</string>
    <key>DEV_BIND</key><string>$BIND</string>
    $preview_env
  </dict>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
</dict></plist>
PLIST
}
ld_run() {
  case "$CMD" in
    install) ld_write; echo "installed $NAME (port $PORT · heap ${HEAP}MB · launchd; no MemoryMax equivalent — heap bounded via NODE_OPTIONS)";;
    up)
      ld_write
      launchctl bootout "gui/$LD_UID/$NAME" 2>/dev/null || true
      kill_adhoc; sleep 1
      launchctl bootstrap "gui/$LD_UID" "$(ld_plist)" || { echo "dev-server: launchctl bootstrap failed (if this is a sandboxed seat, re-run with DEV_BACKEND=bare — see CE-144)" >&2; exit 1; }
      launchctl kickstart "gui/$LD_UID/$NAME" 2>/dev/null || true
      echo "UP  $NAME -> $BIND:$PORT (heap ${HEAP}MB · launchd KeepAlive · logs: $(ld_log))"
      ;;
    down)
      launchctl bootout "gui/$LD_UID/$NAME" 2>/dev/null || true
      ;;  # down_seal verifies + prints (CE-128)
    restart) launchctl kickstart -k "gui/$LD_UID/$NAME" && echo "restarted $NAME";;
    status)
      launchctl print "gui/$LD_UID/$NAME" 2>/dev/null | grep -E "state|pid|last exit" | head -6 \
        || echo "$NAME: not loaded"
      ;;
    logs) tail -n "${LINES:-40}" "$(ld_log)" 2>/dev/null || echo "(no log at $(ld_log))";;
    *) echo "usage: dev-server <up|down|restart|status|logs|install> [PROJECT_PATH]" >&2; exit 1;;
  esac
}

# ── bare backend (no supervisor — seat sandboxes, Linux without a user bus) ──
#    CE-107. Honest about what it is NOT: no auto-restart, no memory cap beyond
#    the node heap bound. It exists so `dev-server up` works inside the wall,
#    which is the only place the coder can actually reach.
ba_dir() { st_dir; }
ba_pid_file() { echo "$(ba_dir)/$NAME.pid"; }
ba_log() { echo "$(ba_dir)/dev-server.log"; }
ba_pid() { cat "$(ba_pid_file)" 2>/dev/null || true; }
# Who is LISTENING on our port for this project? Shared truth (CE-128).
ba_port_pid() { port_holder; }
ba_alive() {
  local p; p="$(ba_pid)"
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then return 0; fi
  [ -n "$(ba_port_pid)" ]
}
ba_up() {
  local cmdline log; cmdline="$(serve_cmd)" || exit 1; log="$(ba_log)"
  ba_alive && { kill "$(ba_pid)" 2>/dev/null || true; sleep 1; }
  kill_adhoc; sleep 1
  # setsid where available so the server outlives the shell that started it;
  # a seat's turn ends, the dev server must not.
  export NODE_OPTIONS="--max-old-space-size=$HEAP" DEV_PORT="$PORT" DEV_BIND="$BIND"
  [ -n "${PREVIEW_DB_URL:-}" ] && export POSTGRES_URL="$PREVIEW_DB_URL"
  # No array here on purpose: `"${arr[@]}"` on an EMPTY array is an unbound-variable
  # ERROR under `set -u` on bash 3.2 (macOS ships it) — caught live 2026-08-17.
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid bash -lc "cd '$PROJ' && exec $cmdline" >"$log" 2>&1 &
  else
    nohup bash -lc "cd '$PROJ' && exec $cmdline" >"$log" 2>&1 &
  fi
  echo $! > "$(ba_pid_file)"
  # Wait for the port to actually answer — "started" is not "serving", and a
  # crash-on-boot must not report UP.
  local i served=""
  for i in $(seq 1 30); do
    if [ -n "$(ba_port_pid)" ]; then served=1; break; fi
    ba_alive || { echo "dev-server: process died on boot — last log lines:" >&2; tail -n 15 "$log" >&2; exit 1; }
    sleep 1
  done
  # Re-pin the pidfile to whoever actually holds the socket (a wrapper may have
  # forked); if lsof is unavailable we keep the launch pid and say so.
  local real; real="$(ba_port_pid)"; [ -n "$real" ] && echo "$real" > "$(ba_pid_file)"
  if [ -z "$served" ]; then
    echo "dev-server: started (pid $(ba_pid)) but nothing is LISTENING on $PORT after 30s — logs: $log" >&2
    exit 1
  fi
  echo "UP  $NAME -> $BIND:$PORT (pid $(ba_pid) · heap ${HEAP}MB · BARE: no supervisor on this host, so NO auto-restart · logs: $log)"
}
ba_run() {
  case "$CMD" in
    install) echo "$NAME: bare backend needs no install (no supervisor on this host); use 'dev-server up'";;
    up)      ba_up;;
    down)    if ba_alive; then kill "$(ba_pid)" 2>/dev/null || true; fi; kill_adhoc; rm -f "$(ba_pid_file)";;  # down_seal verifies + prints (CE-128)
    restart) ba_up;;
    status)
      if ba_alive; then echo "$NAME: running (pid $(ba_pid)) -> $BIND:$PORT · bare, no auto-restart"
      else echo "$NAME: not running (bare backend; pidfile $(ba_pid_file))"; fi;;
    logs)    tail -n "${LINES:-40}" "$(ba_log)" 2>/dev/null || echo "(no log at $(ba_log))";;
    *) echo "usage: dev-server <up|down|restart|status|logs|install> [PROJECT_PATH]" >&2; exit 1;;
  esac
}

# CE-128: `up`/`install` choose a backend fresh (env + host detection) and
# RECORD it; every later command prefers the record over today's auto-detect,
# so a bare `up` is never followed by a systemd `down` that no-ops in silence.
B="$(backend)"
if [ "$CMD" != "up" ] && [ "$CMD" != "install" ]; then
  REC="$(cat "$(backend_marker)" 2>/dev/null || true)"
  case "$REC" in systemd|launchd|bare) B="$REC";; esac
fi
case "$B" in
  systemd) sd_run;;
  launchd) ld_run;;
  bare)    ba_run;;
  *) exit 1;;
esac
case "$CMD" in
  up|restart) echo "$B" > "$(backend_marker)" 2>/dev/null || true;;
  down)       down_seal;;
esac
