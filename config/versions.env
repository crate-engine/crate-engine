# Battle-tested tool versions — the baseline the engine was verified against.
# Since the P6-6 direction change the installer does NOT install agents (they
# are the user's own; the app detects them) — this file RECORDS what the trial
# ladder proved, for reference and support.
# Upgrade procedure: dev/plan/phase-0/pi-pin.md (diff baselines, trial ladder, then bump).
PI_VERSION=0.80.3
PI_INSTALL="npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION}"
