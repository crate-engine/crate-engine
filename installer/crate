#!/usr/bin/env bash
# crate — the shipped Crate Engine CLI (P6-0). Runs DIST-ONLY from the user
# tier's engine clone (~/.crate/engine); no tsx, no dev repo. Installed to
# ~/.local/bin/crate by installer/get-crate.sh.
set -euo pipefail

ENGINE="${CRATE_ENGINE_DIR:-$HOME/.crate/engine}"
CLI="$ENGINE/core/dist/cli.js"

if [ ! -f "$CLI" ]; then
  echo "crate: no engine at $ENGINE (or its core/dist is missing)." >&2
  echo "  fix: run the installer —  curl -fsSL <get-crate.sh URL> | bash" >&2
  echo "  (dev override: CRATE_ENGINE_DIR=<clone> crate ...)" >&2
  exit 1
fi
if [ ! -d "$ENGINE/core/node_modules" ]; then
  echo "crate: engine core deps missing — one-time: cd $ENGINE/core && npm install" >&2
  exit 1
fi

# Prefer the installer's bundled node (linux hosts whose system node is <22 —
# the engine's `engines` floor); else the PATH node.
NODE_BIN="node"
[ -x "$HOME/.crate/tools/node/bin/node" ] && NODE_BIN="$HOME/.crate/tools/node/bin/node"

exec "$NODE_BIN" "$CLI" "$@"
